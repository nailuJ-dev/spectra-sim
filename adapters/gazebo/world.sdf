<?xml version="1.0"?>
<sdf version="1.9">
  <world name="spectra_demo">
    <gravity>0 0 -9.80665</gravity>
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1000 1000 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1000 1000 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="mimo_site_01">
      <static>true</static>
      <pose>0 0 10 0 0 0</pose>
      <link name="mast">
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>20</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="drone_01">
      <static>true</static>
      <pose>180 130 85 0 0 0.49</pose>
      <link name="body">
        <inertial><mass>1.8</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.5 0.5 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.15</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
