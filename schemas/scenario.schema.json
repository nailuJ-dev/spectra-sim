        "tx_power_dbm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "array_elements",
        "bandwidth_hz",
        "carrier_frequency_hz",
        "element_spacing_lambda",
        "noise_figure_db",
        "rx_gain_dbi",
        "subcarrier_spacing_hz",
        "symbols",
        "system_loss_db",
        "tx_gain_dbi",
        "tx_power_dbm"
      ],
      "type": "object"
    },
