          "format": "double",
          "type": "number"
        },
        "symbols": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "system_loss_db": {
          "format": "double",
          "type": "number"
        },
        "tx_gain_dbi": {
