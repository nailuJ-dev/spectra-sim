{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Antenna": {
      "additionalProperties": false,
      "properties": {
        "cable_loss_db": {
          "format": "double",
          "type": "number"
        },
        "gain_dbi": {
          "format": "double",
          "type": "number"
        },
        "pattern": {
          "allOf": [
            {
              "$ref": "#/definitions/AntennaPatternModel"
            }
          ],
          "default": {
            "kind": "isotropic"
          }
        },
        "polarization_loss_db": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "cable_loss_db",
        "gain_dbi",
        "polarization_loss_db"
      ],
      "type": "object"
    },
    "AntennaPatternModel": {
      "description": "Serializable antenna-pattern model used by terrestrial scenario entities.\n\nThe legacy scalar `gain_dbi` remains the boresight gain. Pattern values are applied relative to that gain, except `floor_gain_dbi`, which is an absolute lower gain bound.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "isotropic"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "floor_gain_dbi": {
              "format": "double",
              "type": "number"
            },
            "half_power_beamwidth_deg": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "gaussian"
              ],
              "type": "string"
            }
          },
          "required": [
            "floor_gain_dbi",
            "half_power_beamwidth_deg",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "floor_gain_dbi": {
              "format": "double",
              "type": "number"
            },
            "horizontal_half_power_beamwidth_deg": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "elliptical_gaussian"
              ],
              "type": "string"
            },
            "vertical_half_power_beamwidth_deg": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "floor_gain_dbi",
            "horizontal_half_power_beamwidth_deg",
            "kind",
            "vertical_half_power_beamwidth_deg"
          ],
          "type": "object"
        },
        {
          "description": "`(off_axis_deg, relative_gain_db)` samples. Relative gain must be <= 0.",
          "properties": {
            "kind": {
              "enum": [
                "tabulated_relative"
              ],
              "type": "string"
            },
            "samples": {
              "items": {
                "items": [
                  {
                    "format": "double",
                    "type": "number"
                  },
                  {
                    "format": "double",
                    "type": "number"
                  }
                ],
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "samples"
          ],
          "type": "object"
        }
      ]
    },
    "CooperativeIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string"
        },
